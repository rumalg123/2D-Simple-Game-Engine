{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "msys2-ucrt64",
      "hidden": true,
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "MSYS2_ROOT": "C:/msys64",
        "PATH": "$env{MSYS2_ROOT}/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$env{MSYS2_ROOT}/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "$env{MSYS2_ROOT}/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "$env{MSYS2_ROOT}/ucrt64/bin/ninja.exe",
        "CMAKE_PREFIX_PATH": "$env{MSYS2_ROOT}/ucrt64",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "ucrt64-debug",
      "displayName": "MSYS2 UCRT64 - Debug",
      "inherits": "msys2-ucrt64",
      "binaryDir": "${sourceDir}/build/ucrt64-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ucrt64-release",
      "displayName": "MSYS2 UCRT64 - Release",
      "inherits": "msys2-ucrt64",
      "binaryDir": "${sourceDir}/build/ucrt64-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "ucrt64-debug", "configurePreset": "ucrt64-debug", "jobs": 4 },
    { "name": "ucrt64-release", "configurePreset": "ucrt64-release", "jobs": 4 }
  ],
  "testPresets": [
    {
      "name": "ucrt64-debug",
      "configurePreset": "ucrt64-debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "ucrt64-release",
      "configurePreset": "ucrt64-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
